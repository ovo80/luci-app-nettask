msgstr "File name"

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "大小"
msgstr "Size"

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "修改时间"
msgstr "Modified"

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "权限"
msgstr "Mode"

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "操作"
msgstr "Actions"

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "还没有上传任何脚本。"
msgstr "No scripts have been uploaded yet."

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "试运行"
msgstr "Test run"

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "移除"
msgstr "Remove"

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "脚本 %s 已上传。"
msgstr "Script %s has been uploaded."

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "上传失败：%s"
msgstr "Upload failed: %s"

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "%s 的试运行结果"
msgstr "Test run result of %s"

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "（脚本没有任何输出）"
msgstr "(the script produced no output)"

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "关闭"
msgstr "Close"

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "试运行失败：%s"
msgstr "Test run failed: %s"

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "该文件已不存在。"
msgstr "That file no longer exists."

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "移除脚本"
msgstr "Remove script"

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "确定要移除 %s 吗？"
msgstr "Remove %s?"

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "取消"
msgstr "Cancel"

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "已移除 %s。"
msgstr "%s has been removed."

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "移除失败：%s"
msgstr "Removal failed: %s"

#: htdocs/luci-static/resources/view/nettask/advanced.js
msgid "计划任务已保存并同步到 /etc/crontabs/root。"
msgstr "The schedule has been saved and synced to /etc/crontabs/root."

